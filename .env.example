# ─────────────────────────────────────────────────────────────────────────────
# CampusCrate — Master Environment Variables Reference
# Copy the relevant section to backend/.env or frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Backend (backend/.env) ─────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Supabase PostgreSQL
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432

# AWS S3 (listing images)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION=us-east-1

# CORS (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com


# ── Next.js Frontend (frontend/.env.local) ────────────────────────────────────
# URL the browser will use to call the Django backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of your S3 bucket (for displaying uploaded images)
NEXT_PUBLIC_S3_BUCKET_URL=https://your-s3-bucket-name.s3.us-east-1.amazonaws.com
